# ==========================================
# Omini PDF - Environment Configuration Guide
# Built by Code Garage | Developed by SM Developer
# ==========================================

# 1. FREEMODEL AI (1 MILLION FREE TOKENS API)
# Get your free 1,000,000 tokens API key at: https://freemodel.in
# Compatible with GPT-4o Mini, GPT-4o, DeepSeek, Claude, Gemini, Llama
# You can also set/update this key directly inside the Admin Command Center Settings UI!
FREEMODEL_API_KEY="your_freemodel_api_key_here"
AI_API_BASE_URL="https://freemodel.in/v1"
AI_DEFAULT_MODEL="gpt-4o-mini"

# Legacy Google Gemini fallback (optional)
GEMINI_API_KEY=""

# 2. APPLICATION URL (Recommended for Production SEO)
# The full public domain of your deployed application (e.g., https://ominipdf.com)
# Used for sitemap generation, canonical SEO links, and robots.txt.
APP_URL="https://your-domain.com"

# 3. SERVER PORT (Optional, default is 3000)
# Most cloud providers (Render, Railway, Heroku) inject this automatically.
PORT=3000

# 4. JWT SECRET (Optional, has a built-in secure fallback)
# A random string used to sign user authentication tokens.
JWT_SECRET="generate_a_secure_random_string_for_production"

# 5. ADMIN ACCOUNT CREDENTIALS
# The email address that receives master Admin Command Center privileges.
ADMIN_EMAIL="codegarage1@gmail.com"

# Optional master admin fallback password (if needed)
ADMIN_PASSWORD=""

# 6. NODE ENVIRONMENT
# Set to 'production' on your hosting platform for high-performance static caching.
NODE_ENV="production"
